# ============================================================
#  Vehicle Operations — إعدادات التشغيل
#  انسخ هذا الملف إلى .env ثم شغّل install.sh (سيملأ الأسرار تلقائياً)
# ============================================================

# صورة النظام (يحددها المزوّد). غيّر الإصدار عند التحديث.
APP_IMAGE=ghcr.io/mohamedstar19/vehicle-operations:1.1.0

APP_NAME="Vehicle Operations"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# العنوان العام للنظام (الدومين بتاع العميل)
APP_URL=https://vehicle.example.com
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# المنفذ المحلي الذي يستمع عليه النظام (خلفه reverse proxy / tunnel بـ HTTPS)
APP_PORT=8098

# وضع العرض التجريبي: لازم يفضل false عند العميل
DEMO_MODE=false

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# قاعدة البيانات (تعمل داخل Docker — لا تغيّر DB_HOST)
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=vehicle_ops
DB_USERNAME=vehicle_ops
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

# واتساب (كود التسجيل). اتركه log لتعطيله، أو وجّهه لبوابة رسائل.
WHATSAPP_DRIVER=log
WHATSAPP_BASE_URL=
WHATSAPP_API_KEY=

# ============================================================
#  التفعيل (LICENSOR) — يحدده المزوّد. النظام لا يعمل بدونه.
# ============================================================
LICENSOR_URL=https://licmnyd93mk.darwish-tech.com
LICENSOR_PRODUCT_ID=
LICENSOR_APP_NAME="Vehicle Operations"
